class Solution:
    def kSmallestPairs(self, nums1: List[int], nums2: List[int], k: int):
        arr = []

        n = min(k, len(nums1))
        m = min(k, len(nums2))

        for i in range(n):
            for j in range(m):
                arr.append([nums1[i], nums2[j]])

        arr.sort(key=lambda x: x[0] + x[1])

        return arr[:k]
